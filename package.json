{
  "name": "shieldpro-antivirus",
  "version": "1.0.0",
  "description": "ShieldPro Total Security Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/verify-suite.js",
    "build:exe": "electron-builder --win nsis --x64"
  },
  "keywords": [
    "antivirus",
    "cybersecurity",
    "shieldpro",
    "malware-scanner",
    "firewall",
    "privacy-shredder"
  ],
  "author": "ShieldPro Security Team",
  "license": "ISC",
  "build": {
    "appId": "com.shieldpro.security",
    "productName": "ShieldPro Total Security",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShieldPro Total Security",
      "artifactName": "ShieldPro-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "chokidar": "^6.0.0"
  }
}
